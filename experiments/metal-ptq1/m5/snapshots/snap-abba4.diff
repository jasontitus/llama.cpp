+    } else if (rows_mc == 2 || rows_mc == 4) {
+        nr0 = rows_mc;
+    } else if (rows_mc == 8 && nr1 == 2) {
+        nr0 = 8;
+    } else {
+        nr0 = nr1 == 2 ? 2 : 4;
+    }
+    const int nsg = groups == 2 || groups == 4 ? groups : 1;
